async def imei(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("❌ Informe o IMEI.")
        return
    imei_num = re.sub(r"\D", "", context.args[0])
    if len(imei_num) not in (14, 15):
        await update.message.reply_text("❌ IMEI inválido.")
        return
    try:
        resposta = requests.get("https://api.imeiapi.org/v1/device/" + imei_num, headers={"X-Api-Key": IMEIAPI_KEY}, timeout=20)
        resultado = resposta.json()
    except Exception as e:
        print("ERRO IMEI:", e)
        await update.message.reply_text("❌ Erro ao consultar a API de IMEI.")
        return
    if resultado.get("error") == "not_found":
        await update.message.reply_text("❌ Nenhum aparelho encontrado para este IMEI.")
        return
    mensagem = "📱 RESULTADO IMEI\n\n"
    for chave, valor in resultado.items():
        mensagem += f"🔹 {chave}: {valor}\n"
    await update.message.reply_photo(photo=open("IMG_0324.jpeg", "rb"))
    await update.message.reply_text(mensagem)


def main():
    bot = Application.builder().token(TELEGRAM_TOKEN).build()

    bot.add_handler(CommandHandler("start", start))
    bot.add_handler(CommandHandler("consulta", consulta))
    bot.add_handler(CommandHandler("plano", plano))
    bot.add_handler(CommandHandler("algar", algar))
